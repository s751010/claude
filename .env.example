# أسماء متغيرات البيئة — بلا قيَم.
# انسخ هذا الملف إلى .env.local واملأه. .env.local في .gitignore ولا يُرفع أبداً.
#
# ⚠️ CLAUDE.md القسم 5: أي مفتاح سرّي في كود العميل = فشل فوري.
# المتغيرات المسبوقة بـ NEXT_PUBLIC_ تصل إلى المتصفح — لا تضع فيها سراً أبداً.

# ── Supabase ─────────────────────────────────────────────────────────────
# عام: يصل إلى المتصفح. مفتاح anon مصمَّم ليكون عاماً، والأمان من RLS خلفه.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# سرّي: السيرفر فقط. يتجاوز RLS بالكامل — لا يُستورد في أي مكوّن عميل.
SUPABASE_SERVICE_ROLE_KEY=

# ── بيلينك (Paylink) — السيرفر فقط ───────────────────────────────────────
# تجريبية: https://restpilot.paylink.sa · إنتاجية: https://restapi.paylink.sa
PAYLINK_API_BASE_URL=
PAYLINK_API_ID=
PAYLINK_SECRET_KEY=
# سرّ التحقق من صحة الـ webhook قبل معالجته
PAYLINK_WEBHOOK_SECRET=

# ── الذكاء الاصطناعي (ماجد) — يُقرأ داخل Edge Function، لا في التطبيق ────
AI_API_KEY=

# ── التطبيق ──────────────────────────────────────────────────────────────
# العنوان العام الكامل — يُستخدم في روابط QR و callBackUrl
NEXT_PUBLIC_SITE_URL=
